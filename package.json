{
  "name": "@readyrun/readyrun",
  "version": "0.3.0",
  "description": "Walk a tracker Frontier and run one coding Worker per Ticket.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelBuss/readyrun.git"
  },
  "bin": {
    "readyrun": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/mod.js",
    "./cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "readyrun": "node src/cli.ts",
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-version.ts",
    "release": "node scripts/release.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0"
  }
}
